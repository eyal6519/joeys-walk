{
  "name": "walklogger",
  "version": "0.1.0",
  "private": true,
  "description": "Joey's Log - potty and walk tracking for a toy poodle, built on Firebase.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/run-local.mjs",
    "dev": "npm run dev --workspace @walklogger/web",
    "build": "npm run build --workspace @walklogger/web",
    "lint": "npm run lint --workspace @walklogger/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:env": "node scripts/check-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test:rules": "firebase emulators:exec --only firestore --project walklogger-c02fa \"vitest run --root tests/rules\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2",
    "vitest": "5.0.5",
    "prettier": "3.9.10"
  }
}
