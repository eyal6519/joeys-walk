# =============================================================================
# WalkLogger - example environment file
#
# Copy to .env.local and fill in from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#   -> SDK setup and configuration -> Config
#
# These values are NOT secrets. Firebase web config is shipped to every browser
# by design; access is controlled by Security Rules and App Check, not by
# hiding these keys. Never put a service account key here.
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Point the app at the local Firebase Emulator Suite instead of production.
# Set to "true" for local development so nothing touches real data.
NEXT_PUBLIC_USE_EMULATORS=false

# Design preview: skip sign-in and Firebase entirely and serve a seeded,
# in-memory household. Development builds only; ignored in production builds.
# Run `npm run preview` (or set to "1" here and `npm run dev`).
NEXT_PUBLIC_PREVIEW=0
