rules_version = '2';

// =============================================================================
// WalkLogger - Firestore security rules
//
// NOTE (phase 0): this is the "secure by default" baseline. Every document is
// denied. Real household-scoped rules with schema validation land in phase 2.
// Deploying this is always safe: it exposes nothing.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
